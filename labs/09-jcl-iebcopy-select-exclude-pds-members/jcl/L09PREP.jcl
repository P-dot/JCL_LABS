//L09PREP  JOB (ACCT),'LAB09 PREP',
//             CLASS=A,
//             MSGCLASS=X,
//             MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//*
//* LAB 09 - PREPARE SOURCE PDS MEMBERS
//MEMA     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
LAB09 MEMBER SELONE
THIS MEMBER WILL BE USED FOR SELECT TESTING
/*
